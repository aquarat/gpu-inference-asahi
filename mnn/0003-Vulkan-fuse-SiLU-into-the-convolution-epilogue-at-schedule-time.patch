+bool VulkanBackend::onSupportFusedActivation(const std::vector<Tensor*>& inputs, const std::vector<Tensor*>& outputs,
+                                             const MNN::Op* op, int activation) const {
+    // The convolution shaders (1x1, depthwise, im2col+col2Im, winograd) apply SiLU in their
+    // epilogue, selected through VulkanConvolutionCommon::getPostTreatMacro.
+    if (activation != UnaryOpOperation_SILU) {
+        return false;
+    }
+    if ((op->type() != OpType_Convolution && op->type() != OpType_ConvolutionDepthwise) ||
+        op->main_type() != OpParameter_Convolution2D || inputs.size() != 1 || outputs.size() != 1) {
+        return false;
+    }
+    if (op->type() == OpType_Convolution && op->main_as_Convolution2D()->common()->group() != 1) {
+        return false;
+    }
+    return _supportImageSize(inputs[0]) && _supportImageSize(outputs[0]);
+}
