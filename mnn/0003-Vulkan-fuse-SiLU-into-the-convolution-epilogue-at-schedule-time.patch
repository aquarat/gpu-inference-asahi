 Execution* CPUBackend::onCreate(const std::vector<Tensor*>& inputs, const std::vector<Tensor*>& outputs,
                                 const MNN::Op* op) {
     /**
@@ -797,6 +846,17 @@ Execution* CPUBackend::onCreate(const std::vector<Tensor*>& inputs, const std::v
     if (exe == nullptr) {
         exe = iter->second->onCreate(inputs, outputs, op, this);
     }
+    if (nullptr != exe && (opType == OpType_Convolution || opType == OpType_ConvolutionDepthwise) &&
+        op->main_type() == OpParameter_Convolution2D && 0 != op->main_as_Convolution2D()->common()->fusedActivation()) {
+        auto activation = op->main_as_Convolution2D()->common()->fusedActivation();
+        auto proc       = functions()->MNNSelectUnaryFunctionForFloat(activation, precisionMode());
+        if (nullptr == proc) {
+            MNN_ERROR("CPUBackend: unsupported fusedActivation %d for convolution\n", activation);
+            delete exe;
+            return nullptr;
+        }
+        exe = new CPUConvolutionFusedActivation(this, exe, proc);
+    }
     return exe;
 }
