+/**
+ Fuse Convolution -> UnaryOp(activation) into the convolution's epilogue when the main
+ backend claims support (Backend::onSupportFusedActivation). The convolution op is
+ re-packed with Convolution2DCommon::fusedActivation set and writes the unary's output
+ directly; the unary command is dropped. Runs on the command list after geometry compute,
+ so it works for models converted by any converter (the fusion is a runtime decision).
+ */
+void Pipeline::_fuseConvolutionActivation() {
+    auto backend = mInfo.first.cache.first.get();
+    std::map<const Tensor*, int> consumerCount;
+    std::map<const Tensor*, Command*> producer;
+    for (auto& info : mInfo.second) {
+        if (info.type == Schedule::CONSTANT) {
+            continue;
+        }
+        for (auto& cmdP : info.executeBuffer.command) {
+            for (auto t : cmdP->inputs) {
+                consumerCount[t] += 1;
+            }
+            for (auto t : cmdP->outputs) {
+                producer[t] = cmdP.get();
+            }
+        }
+    }
+    for (auto& info : mInfo.second) {
+        if (info.type == Schedule::CONSTANT) {
+            continue;
+        }
+        auto& commands = info.executeBuffer.command;
+        for (auto iter = commands.begin(); iter != commands.end();) {
+            auto& act = **iter;
+            if (act.op->type() != OpType_UnaryOp || act.op->main_type() != OpParameter_UnaryOp ||
+                act.inputs.size() != 1 || act.outputs.size() != 1) {
+                ++iter;
+                continue;
+            }
+            auto activation = act.op->main_as_UnaryOp()->opType();
+            auto mid        = act.inputs[0];
+            auto out        = act.outputs[0];
+            auto prodIter   = producer.find(mid);
+            if (prodIter == producer.end()) {
+                ++iter;
+                continue;
+            }
+            auto conv = prodIter->second;
+            if ((conv->op->type() != OpType_Convolution && conv->op->type() != OpType_ConvolutionDepthwise) ||
+                conv->op->main_type() != OpParameter_Convolution2D || conv->inputs.size() != 1 ||
+                conv->outputs.size() != 1 || conv->outputs[0] != mid) {
+                ++iter;
+                continue;
+            }
+            auto common = conv->op->main_as_Convolution2D()->common();
+            if (common->relu() || common->relu6() || common->fusedActivation() != 0) {
+                ++iter;
+                continue;
+            }
+            auto midDes = TensorUtils::getDescribe(mid);
+            auto outDes = TensorUtils::getDescribe(out);
+            bool valid = consumerCount[mid] == 1 && midDes->usage == Tensor::InsideDescribe::NORMAL &&
+                         midDes->memoryType == Tensor::InsideDescribe::MEMORY_BACKEND &&
+                         outDes->memoryType == Tensor::InsideDescribe::MEMORY_BACKEND &&
+                         midDes->quantAttr == nullptr && outDes->quantAttr == nullptr &&
+                         midDes->dimensionFormat == outDes->dimensionFormat && midDes->regions.empty() &&
+                         mid->getType() == out->getType() && mid->dimensions() == out->dimensions();
+            for (int i = 0; valid && i < mid->dimensions(); ++i) {
+                valid = mid->length(i) == out->length(i);
+            }
+            if (!valid || !backend->onSupportFusedActivation(conv->inputs, act.outputs, conv->op, activation)) {
+                ++iter;
+                continue;
+            }
+            auto fusedIter = mFusedOps.find(conv->op);
+            if (fusedIter == mFusedOps.end()) {
+                std::unique_ptr<OpT> opT(conv->op->UnPack());
+                opT->main.AsConvolution2D()->common->fusedActivation = activation;
+                flatbuffers::FlatBufferBuilder builder;
+                builder.Finish(Op::Pack(builder, opT.get()));
+                std::shared_ptr<BufferStorage> storage(new BufferStorage);
+                storage->storage = builder.ReleaseRaw(storage->allocated_size, storage->offset);
+                fusedIter = mFusedOps.insert(std::make_pair(conv->op, storage)).first;
+            }
+            conv->op         = flatbuffers::GetRoot<Op>(fusedIter->second->buffer());
+            conv->outputs[0] = out;
+            producer[out]    = conv;
+            iter             = commands.erase(iter);
+        }
+    }
+}
