 /// get execution
+/**
+ Applies Convolution2DCommon::fusedActivation after a convolution execution that does not
+ implement it itself. The flag is set at schedule time (Pipeline::_fuseConvolutionActivation)
+ for a backend that accepted it; if that backend then declines the op, the CPU backend is the
+ fallback and must still honour the activation.
+ */
+class CPUConvolutionFusedActivation : public Execution {
+public:
+    CPUConvolutionFusedActivation(Backend* bn, Execution* conv, MNNUnaryExecute proc)
+        : Execution(bn), mConv(conv), mProc(proc) {
+        mValid = conv->valid();
+    }
+    virtual ErrorCode onResize(const std::vector<Tensor*>& inputs, const std::vector<Tensor*>& outputs) override {
+        return mConv->onResize(inputs, outputs);
+    }
+    virtual ErrorCode onExecute(const std::vector<Tensor*>& inputs, const std::vector<Tensor*>& outputs) override {
+        auto code = mConv->onExecute(inputs, outputs);
+        if (NO_ERROR != code) {
+            return code;
+        }
+        auto output  = outputs[0];
+        size_t count = output->elementSize();
+        if (TensorUtils::getDescribe(output)->dimensionFormat == MNN_DATA_FORMAT_NC4HW4 && output->dimensions() >= 2) {
+            auto pack   = static_cast<CPUBackend*>(backend())->functions()->pack;
+            size_t area = 1;
+            for (int i = 2; i < output->dimensions(); ++i) {
+                area *= output->length(i);
+            }
+            count = (size_t)output->length(0) * UP_DIV(output->length(1), pack) * pack * area;
+        }
+        // The unary kernels are not guaranteed to be in-place safe (MNNSiLu writes exp(-x) to dst
+        // before reading src again), so feed them from a small scratch copy.
+        auto bytes = static_cast<CPUBackend*>(backend())->functions()->bytes;
+        uint8_t scratch[1024 * 4];
+        const size_t chunk = sizeof(scratch) / bytes;
+        auto ptr = output->host<uint8_t>();
+        for (size_t offset = 0; offset < count; offset += chunk) {
+            auto n = std::min(chunk, count - offset);
+            ::memcpy(scratch, ptr + offset * bytes, n * bytes);
+            mProc(ptr + offset * bytes, scratch, (int)n);
+        }
+        return NO_ERROR;
+    }
+
+private:
+    std::shared_ptr<Execution> mConv;
+    MNNUnaryExecute mProc;
+};
