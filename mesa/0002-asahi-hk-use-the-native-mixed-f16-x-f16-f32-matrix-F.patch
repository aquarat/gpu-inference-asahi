From 7dd673b739deaa1a8f00df2a0b08fb11eb6926fb Mon Sep 17 00:00:00 2001
From: Aaron <blue@aquarat.co.uk>
Date: Sun, 6 Sep 2026 12:31:27 +0100
Subject: [PATCH 2/3] asahi/hk: use the native mixed f16 x f16 + f32 matrix FMA

The hardware honours per-operand size flags: f16 register pairs for A and B
with an f32 pair for C/D (bit 26 set from the accumulator) is bit-exact and
accumulates in f32 (4096 + 8 * 1/64 = 4096.125 comes back exactly, where an
f16 accumulator rounds it to 4096). Make that the default; HK_CMAT_WIDEN=1
keeps the widen-to-f32 form for experiments.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VXX3uBLex4GVki947Lm5qV

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../vulkan/hk_nir_lower_cooperative_matrix.c    | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/src/asahi/vulkan/hk_nir_lower_cooperative_matrix.c b/src/asahi/vulkan/hk_nir_lower_cooperative_matrix.c
index 731e6b1..2b45484 100644
--- a/src/asahi/vulkan/hk_nir_lower_cooperative_matrix.c
+++ b/src/asahi/vulkan/hk_nir_lower_cooperative_matrix.c
@@ -235,17 +235,18 @@ lower_cmat_instr(nir_builder *b, nir_instr *instr, struct lower_cmat_ctx *ctx)
       nir_def *b_mat = load_cmat_src(b, intr->src[2]);
       nir_def *acc = load_cmat_src(b, intr->src[3]);
 
-      /* Mixed f16 x f16 + f32: the hardware variant is selected by the
-       * accumulator size. Widen A and B elementwise (exact, same layout) and
-       * use the f32 instruction. HK_CMAT_MIXED=1 tries the raw mixed encoding
-       * instead (experiment: is it supported by the hardware?).
+      /* Mixed f16 x f16 + f32 is supported natively: the per-operand size
+       * flags are honoured and bit 26 (the fmadd32 variant) follows the
+       * accumulator, verified bit-exact on G13G. HK_CMAT_WIDEN=1 instead
+       * widens A and B to f32 elementwise (exact, same layout) and uses the
+       * all-f32 form, kept for experiments.
        */
       if (ab_bits != c_bits) {
-         static int mixed = -1;
-         if (mixed < 0)
-            mixed = debug_get_bool_option("HK_CMAT_MIXED", false);
+         static int widen = -1;
+         if (widen < 0)
+            widen = debug_get_bool_option("HK_CMAT_WIDEN", false);
 
-         if (!mixed) {
+         if (widen) {
             a = nir_f2f32(b, a);
             b_mat = nir_f2f32(b, b_mat);
          }
