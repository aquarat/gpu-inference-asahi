diff --git a/docs/docs/install/environment-variables.md b/docs/docs/install/environment-variables.md
index c10a858..d3d4e35 100644
--- a/docs/docs/install/environment-variables.md
+++ b/docs/docs/install/environment-variables.md
@@ -179,6 +179,11 @@ Redis (Sentinel) URL example JSON before encoding:
 | `MACHINE_LEARNING_MAX_BATCH_SIZE__OCR`                      | Set the maximum number of boxes that will be processed at once by the OCR model                                                                              |             `6`              | machine learning |
 | `MACHINE_LEARNING_RKNN`                                     | Enable RKNN hardware acceleration if supported                                                                                                               |            `True`            | machine learning |
 | `MACHINE_LEARNING_RKNN_THREADS`                             | How many threads of RKNN runtime should be spun up while inferencing.                                                                                        |             `1`              | machine learning |
+| `MACHINE_LEARNING_GGML`                                     | Enable ggml (Vulkan) hardware acceleration for CLIP image models if supported                                                                                |            `True`            | machine learning |
+| `MACHINE_LEARNING_GGML_PRECISION`                           | Model precision for the ggml backend: `FP32` or `FP16` (faster, very slightly lower accuracy)                                                                |            `FP32`            | machine learning |
+| `MACHINE_LEARNING_GGML_WEIGHT_TYPE`                         | Weight storage for the ggml backend: `f16` or `q8_0` (half the GPU memory)                                                                                   |            `f16`             | machine learning |
+| `MACHINE_LEARNING_GGML_FLASH_ATTN`                          | Use the fused flash attention op on the ggml backend                                                                                                         |            `True`            | machine learning |
+| `MACHINE_LEARNING_GGML_THREADS`                             | CPU threads for ggml ops the GPU cannot run                                                                                                                  |             `4`              | machine learning |
 | `MACHINE_LEARNING_MODEL_ARENA`                              | Pre-allocates CPU memory to avoid memory fragmentation                                                                                                       |             true             | machine learning |
 | `MACHINE_LEARNING_OPENVINO_PRECISION`                       | If set to FP16, uses half-precision floating-point operations for faster inference with reduced accuracy (one of [`FP16`, `FP32`], applies only to OpenVINO) |            `FP32`            | machine learning |
 
diff --git a/machine-learning/Dockerfile b/machine-learning/Dockerfile
index c8191e3..6b11a4a 100644
--- a/machine-learning/Dockerfile
+++ b/machine-learning/Dockerfile
@@ -18,6 +18,16 @@ RUN mkdir /opt/armnn && \
     cd /opt/ann && \
     sh build.sh
 
+FROM builder-cpu AS builder-ggml
+
+# renovate: datasource=github-tags depName=ggml-org/ggml
+ARG GGML_VERSION="master"
+
+COPY ggml /opt/clipvit
+RUN apt-get update && apt-get install -y --no-install-recommends cmake git glslc libvulkan-dev spirv-headers && \
+    cd /opt/clipvit && \
+    CLIPVIT_GGML_TAG="${GGML_VERSION}" sh build.sh -DCLIPVIT_BUILD_CLI=OFF
+
 FROM builder-cpu AS builder-rknn
 
 # Warning: 25GiB+ disk space required to pull this image
@@ -104,6 +114,17 @@ COPY --from=builder-armnn \
     /opt/ann/build.sh \
     /opt/armnn/
 
+FROM prod-cpu AS prod-ggml
+
+ENV LD_PRELOAD=/usr/lib/libmimalloc.so.2 \
+    MACHINE_LEARNING_MODEL_ARENA=false
+
+# the Vulkan loader and Mesa's drivers; a vendor driver (ICD) can also be bind-mounted from the host
+RUN apt-get update && apt-get install -y --no-install-recommends libvulkan1 mesa-vulkan-drivers && \
+    rm -rf /var/lib/apt/lists/*
+
+COPY --from=builder-ggml /opt/clipvit/build/libclipvit.so /usr/lib/
+
 FROM prod-cpu AS prod-rknn
 
 # renovate: datasource=github-tags depName=airockchip/rknn-toolkit2
