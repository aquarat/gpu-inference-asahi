@@ -0,0 +1,67 @@
+# libclipvit: CLIP vision transformer encoder on ggml (Vulkan GPU / CPU), used by
+# immich_ml.sessions.ggml. ggml and its backends are linked statically so the runtime
+# only needs libclipvit.so, the Vulkan loader and the host's Vulkan driver (ICD).
+#
+#   cmake -B build -DCMAKE_BUILD_TYPE=Release [-DCLIPVIT_GGML_DIR=/path/to/ggml]
+#   cmake --build build -j4 && cmake --install build --prefix /opt/clipvit
+cmake_minimum_required(VERSION 3.24)
+project(clipvit LANGUAGES C CXX VERSION 0.1.0)
+
+option(CLIPVIT_VULKAN "Build the ggml Vulkan backend" ON)
+option(CLIPVIT_BUILD_CLI "Build the clipvit-cli test tool" ON)
+set(CLIPVIT_GGML_DIR "" CACHE PATH "Existing ggml source tree (default: fetch ggml-org/ggml at CLIPVIT_GGML_TAG)")
+set(CLIPVIT_GGML_TAG "master" CACHE STRING "ggml git ref to fetch when CLIPVIT_GGML_DIR is empty")
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+if(NOT CMAKE_BUILD_TYPE)
+    set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
+endif()
+
+# ggml configuration: static libraries compiled into libclipvit.so, no dynamic backend loading.
+set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
+set(GGML_BACKEND_DL OFF CACHE BOOL "" FORCE)
+set(GGML_VULKAN ${CLIPVIT_VULKAN} CACHE BOOL "" FORCE)
+set(GGML_OPENMP OFF CACHE BOOL "")
+set(GGML_NATIVE OFF CACHE BOOL "")
+set(GGML_BUILD_TESTS OFF CACHE BOOL "" FORCE)
+set(GGML_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
+set(GGML_ALL_WARNINGS OFF CACHE BOOL "")
+
+if(CLIPVIT_GGML_DIR)
+    add_subdirectory(${CLIPVIT_GGML_DIR} ggml EXCLUDE_FROM_ALL)
+else()
+    include(FetchContent)
+    FetchContent_Declare(ggml
+        GIT_REPOSITORY https://github.com/ggml-org/ggml.git
+        GIT_TAG ${CLIPVIT_GGML_TAG}
+        GIT_SHALLOW TRUE
+        EXCLUDE_FROM_ALL)
+    FetchContent_MakeAvailable(ggml)
+endif()
+
+add_library(clipvit SHARED clipvit.cpp clipvit.h)
+target_link_libraries(clipvit PRIVATE ggml)
+set_target_properties(clipvit PROPERTIES
+    C_VISIBILITY_PRESET hidden
+    CXX_VISIBILITY_PRESET hidden
+    VISIBILITY_INLINES_HIDDEN ON
+    PUBLIC_HEADER clipvit.h)
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+    # keep the ggml symbols private to this library
+    target_link_options(clipvit PRIVATE "LINKER:--exclude-libs,ALL")
+endif()
+
+if(CLIPVIT_BUILD_CLI)
+    add_executable(clipvit-cli clipvit-cli.cpp)
+    target_link_libraries(clipvit-cli PRIVATE clipvit)
+endif()
+
+include(GNUInstallDirs)
+install(TARGETS clipvit
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    PUBLIC_HEADER DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
+if(CLIPVIT_BUILD_CLI)
+    install(TARGETS clipvit-cli RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
+endif()
