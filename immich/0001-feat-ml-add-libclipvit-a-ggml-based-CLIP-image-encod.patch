+// C API for the ggml-based CLIP vision transformer encoder (libclipvit).
+//
+// Loads a GGUF produced by immich_ml.sessions.ggml.convert (an open_clip
+// VisionTransformer: patch conv, class/pos embeddings, ln_pre, N residual
+// attention blocks, ln_post on the class token, visual projection) and encodes
+// preprocessed NCHW float32 images into L2-normalised embeddings on a ggml
+// backend (Vulkan GPU, or the CPU as a fallback).
+#ifndef CLIPVIT_H
+#define CLIPVIT_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#ifdef _WIN32
+#define CLIPVIT_API __declspec(dllexport)
+#else
+#define CLIPVIT_API __attribute__((visibility("default")))
+#endif
+
+typedef struct clipvit_model clipvit_model;
+
+struct clipvit_params {
+    // Index into the GPU devices reported by clipvit_device_count(); -1 runs on the CPU.
+    int device;
+    // Threads for the CPU backend (used for the CPU device and for ops the GPU cannot run).
+    int n_threads;
+    // Use ggml's fused flash attention op (1) or the explicit softmax(QK^T)V path (0).
+    int flash_attn;
+    // Force fp32 shader arithmetic on the Vulkan backend (sets GGML_VK_DISABLE_F16 before
+    // the backend is initialised; process-wide, so it applies to the first model loaded).
+    int fp32_math;
+};
+
+// Fill params with defaults: device 0, 4 threads, flash attention on, fp16 math.
+CLIPVIT_API void clipvit_params_default(struct clipvit_params * params);
+
+// Number of GPU devices (integrated or discrete) ggml can see, and their descriptions.
+CLIPVIT_API int clipvit_device_count(void);
+CLIPVIT_API const char * clipvit_device_description(int index);
+
+// Load a model. Returns NULL on failure; see clipvit_last_error().
+CLIPVIT_API clipvit_model * clipvit_load(const char * gguf_path, const struct clipvit_params * params);
+CLIPVIT_API void clipvit_free(clipvit_model * model);
+
+// Encode n images (n x 3 x S x S float32, S = clipvit_image_size) into out (n x clipvit_embed_dim),
+// L2-normalised. Returns 0 on success. Safe to call from several threads (serialised internally).
+CLIPVIT_API int clipvit_encode(clipvit_model * model, const float * images, int n, float * out);
+
+CLIPVIT_API int clipvit_embed_dim(const clipvit_model * model);
+CLIPVIT_API int clipvit_image_size(const clipvit_model * model);
+// Name of the backend the model runs on, e.g. "Vulkan0 (Apple M1 (G13G B1) (Honeykrisp))".
+CLIPVIT_API const char * clipvit_device_name(const clipvit_model * model);
+// Size of the weight buffer on the device, in bytes.
+CLIPVIT_API size_t clipvit_weights_bytes(const clipvit_model * model);
+// Number of graph nodes the main backend cannot run (they fall back to the CPU); 0 is expected.
+CLIPVIT_API int clipvit_unsupported_ops(const clipvit_model * model);
+
+// Last error message of the calling thread (empty string if none).
+CLIPVIT_API const char * clipvit_last_error(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
