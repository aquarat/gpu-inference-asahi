@@ -0,0 +1,67 @@
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, NamedTuple
+
+import numpy as np
+from numpy.typing import NDArray
+
+from immich_ml.config import log, settings
+from immich_ml.schemas import ModelPrecision, SessionNode
+
+from .loader import ClipVit, is_available
+
+
+class GgmlSession:
+    """
+    Runs CLIP visual models on the GPU through ggml (Vulkan), as a drop-in replacement for an ONNX session.
+    """
+
+    def __init__(self, model_path: Path) -> None:
+        self.model_path = model_path
+        log.info("Loading ggml model %s ...", model_path)
+        self.model = ClipVit(
+            model_path,
+            device=int(settings.device_id),
+            n_threads=settings.ggml_threads,
+            flash_attn=settings.ggml_flash_attn,
+            fp32_math=settings.ggml_precision == ModelPrecision.FP32,
+        )
+        log.info(
+            "Loaded ggml model on %s (%.0f MB of weights, %s math)",
+            self.model.device_name,
+            self.model.weights_bytes / 1e6,
+            settings.ggml_precision.value,
+        )
+        if self.model.unsupported_ops:
+            log.warning(
+                "%d graph nodes are not supported by the GPU and will run on the CPU", self.model.unsupported_ops
+            )
+
+    def get_inputs(self) -> list[SessionNode]:
+        return [GgmlNode("image", (1, 3, self.model.image_size, self.model.image_size))]
+
+    def get_outputs(self) -> list[SessionNode]:
+        return [GgmlNode("embedding", (1, self.model.embed_dim))]
+
+    def get_metadata(self) -> dict[str, str]:
+        return {}
+
+    def run(
+        self,
+        output_names: list[str] | None,
+        input_feed: dict[str, NDArray[np.float32]] | dict[str, NDArray[np.int32]] | dict[str, NDArray[np.uint8]],
+        run_options: Any = None,
+    ) -> list[NDArray[np.float32]]:
+        if len(input_feed) != 1:
+            raise ValueError(f"expected a single image input, got {list(input_feed)}")
+        image: NDArray[np.float32] = np.ascontiguousarray(next(iter(input_feed.values())), dtype=np.float32)
+        return [self.model.encode(image)]
+
+
+class GgmlNode(NamedTuple):
+    name: str
+    shape: tuple[int, ...]
+
+
+__all__ = ["GgmlSession", "GgmlNode", "is_available"]
diff --git a/machine-learning/immich_ml/sessions/ggml/convert.py b/machine-learning/immich_ml/sessions/ggml/convert.py
