--- /dev/null
+++ b/machine-learning/immich_ml/sessions/ggml/convert.py
@@ -0,0 +1,197 @@
+"""Converts an open_clip visual ONNX export into a GGUF file for libclipvit.
+
+The weights are read straight from the ONNX file Immich already downloads (including external data
+files, memory-mapped), so the GGUF holds exactly the weights the ONNX session would serve. Supported
+models are open_clip VisionTransformer exports: conv1 patch embedding, class and positional embeddings,
+ln_pre, N residual attention blocks with a fused in_proj and a c_fc/c_proj MLP, ln_post on the class
+token and visual.proj (ViT-B-32, ViT-B-16, ViT-L-14, ViT-H-14, ...). SigLIP and other architectures
+raise UnsupportedModelError so the caller can fall back to ONNX.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+from typing import Any, Literal
+
+import numpy as np
+import onnx
+from numpy.typing import NDArray
+
+WeightType = Literal["f16", "q8_0"]
+WEIGHT_TYPE_KEY = "clip-vit.weight_type"
+
+
+class UnsupportedModelError(ValueError):
+    pass
+
+
+def gguf_weight_type(path: Path) -> str | None:
+    """Returns the weight type recorded in a GGUF written by convert_visual_model, or None."""
+    from gguf import GGUFReader
+
+    try:
+        field = GGUFReader(path).fields.get(WEIGHT_TYPE_KEY)
+    except (OSError, ValueError):
+        return None
+    if field is None:
+        return None
+    return bytes(field.parts[field.data[0]]).decode()
+
+
+class _OnnxWeights:
+    def __init__(self, onnx_path: Path) -> None:
+        self.onnx_path = onnx_path
+        self.model = onnx.load(onnx_path.as_posix(), load_external_data=False)
+        self.graph = self.model.graph
+        self.initializers = {t.name: t for t in self.graph.initializer}
+        self.nodes = {n.name: n for n in self.graph.node}
+
+    def load(self, name: str) -> NDArray[np.float32]:
+        tensor = self.initializers.get(name)
+        if tensor is None:
+            raise UnsupportedModelError(f"initializer {name} not found")
+        if tensor.data_location == onnx.TensorProto.EXTERNAL:
+            info = {kv.key: kv.value for kv in tensor.external_data}
+            path = self.onnx_path.parent / info["location"]
+            offset = int(info.get("offset", 0))
+            length = int(info.get("length", os.path.getsize(path) - offset))
+            dtype = onnx.helper.tensor_dtype_to_np_dtype(tensor.data_type)
+            data = np.memmap(path, dtype=dtype, mode="r", offset=offset, shape=(length // np.dtype(dtype).itemsize,))
+            return np.asarray(data, dtype=np.float32).reshape(list(tensor.dims))
+        return np.asarray(onnx.numpy_helper.to_array(tensor), dtype=np.float32)
+
+    def matmul_weight(self, node_name: str) -> NDArray[np.float32]:
+        """The weight of a MatMul/Gemm node, in [out, in] (torch Linear) layout."""
+        node = self.nodes.get(node_name)
+        if node is None or node.op_type not in ("MatMul", "Gemm"):
+            raise UnsupportedModelError(f"node {node_name} not found")
+        weights = [i for i in node.input if i in self.initializers]
+        if not weights:
+            raise UnsupportedModelError(f"node {node_name} has no constant weight")
+        arr = self.load(weights[0])
+        if node.op_type == "Gemm":
+            trans_b = [onnx.helper.get_attribute_value(a) for a in node.attribute if a.name == "transB"]
+            return arr if trans_b and trans_b[0] else arr.T
+        return arr.T
+
+    def initializer_input(self, node_name: str) -> NDArray[np.float32]:
+        node = self.nodes.get(node_name)
+        if node is None:
+            raise UnsupportedModelError(f"node {node_name} not found")
+        names = [i for i in node.input if i in self.initializers]
+        if not names:
+            raise UnsupportedModelError(f"node {node_name} has no constant input")
+        return self.load(names[0])
+
+    def count_ops(self, op_type: str) -> int:
+        return sum(1 for n in self.graph.node if n.op_type == op_type)
+
+    def layer_norm_eps(self) -> float:
+        for node in self.graph.node:
+            if node.op_type == "LayerNormalization":
+                for attr in node.attribute:
+                    if attr.name == "epsilon":
+                        return float(onnx.helper.get_attribute_value(attr))
+        raise UnsupportedModelError("no LayerNormalization node found")
+
+
+def convert_visual_model(model_dir: Path, output: Path, weight_type: WeightType = "f16") -> None:
+    """Writes `output` from `<model_dir>/config.json`, `<model_dir>/visual/model.onnx` and `preprocess_cfg.json`."""
+    import gguf
+    from gguf import GGMLQuantizationType
+
+    onnx_path = model_dir / "visual" / "model.onnx"
+    try:
+        cfg: dict[str, Any] = json.load((model_dir / "config.json").open(encoding="utf-8"))
+        preprocess: dict[str, Any] = json.load((model_dir / "visual" / "preprocess_cfg.json").open(encoding="utf-8"))
+        vision_cfg = cfg["vision_cfg"]
+        width, layers = int(vision_cfg["width"]), int(vision_cfg["layers"])
+        patch, image_size = int(vision_cfg["patch_size"]), int(vision_cfg["image_size"])
+        heads = width // int(vision_cfg.get("head_width", 64))
+        embed_dim = int(cfg["embed_dim"])
+    except (OSError, KeyError, TypeError, ValueError) as e:
+        raise UnsupportedModelError(f"not an open_clip vision transformer config: {e}") from e
+
+    weights = _OnnxWeights(onnx_path)
+    n_sigmoid, n_erf = weights.count_ops("Sigmoid"), weights.count_ops("Erf")
+    if n_sigmoid == layers and n_erf == 0:
+        gelu = "quick"
+    elif n_erf == layers and n_sigmoid == 0:
+        gelu = "erf"
+    else:
+        raise UnsupportedModelError(f"cannot determine the GELU variant (sigmoid={n_sigmoid}, erf={n_erf})")
+    ln_eps = weights.layer_norm_eps()
+
+    class_embd = weights.initializer_input("/visual/Expand").reshape(-1)
+    pos_embd = weights.initializer_input("/visual/Add")
+    n_pos = (image_size // patch) ** 2 + 1
+    if class_embd.shape != (width,) or pos_embd.shape != (n_pos, width):
+        raise UnsupportedModelError(f"unexpected embedding shapes {class_embd.shape}, {pos_embd.shape}")
+
+    tmp_output = output.with_name(output.name + ".tmp")
+    writer = gguf.GGUFWriter(tmp_output.as_posix(), "clip-vit")
+    try:
+        writer.add_name(model_dir.name)
+        writer.add_description("open_clip VisionTransformer converted from ONNX for libclipvit")
+        writer.add_file_type(gguf.LlamaFileType.MOSTLY_Q8_0 if weight_type == "q8_0" else gguf.LlamaFileType.MOSTLY_F16)
+        writer.add_string(WEIGHT_TYPE_KEY, weight_type)
+        writer.add_uint32("clip-vit.width", width)
+        writer.add_uint32("clip-vit.layers", layers)
+        writer.add_uint32("clip-vit.heads", heads)
+        writer.add_uint32("clip-vit.patch_size", patch)
+        writer.add_uint32("clip-vit.image_size", image_size)
+        writer.add_uint32("clip-vit.embed_dim", embed_dim)
+        writer.add_float32("clip-vit.ln_eps", ln_eps)
+        writer.add_string("clip-vit.gelu", gelu)
+        writer.add_array("clip-vit.image_mean", [float(x) for x in preprocess["mean"]])
+        writer.add_array("clip-vit.image_std", [float(x) for x in preprocess["std"]])
+
+        def add(name: str, arr: NDArray[np.float32], kind: Literal["mat", "f16", "f32"]) -> None:
+            arr = np.ascontiguousarray(arr, dtype=np.float32)
+            if kind == "f32":
+                writer.add_tensor(name, arr)
+            elif kind == "mat" and weight_type == "q8_0" and arr.shape[-1] % 32 == 0:
+                writer.add_tensor(
+                    name, gguf.quants.quantize(arr, GGMLQuantizationType.Q8_0), raw_dtype=GGMLQuantizationType.Q8_0
+                )
+            else:
+                writer.add_tensor(name, arr.astype(np.float16))
+
+        add("patch_w", weights.load("visual.conv1.weight"), "f16")
+        add("class_embd", class_embd, "f32")
+        add("pos_embd", pos_embd, "f32")
+        add("ln_pre_w", weights.load("visual.ln_pre.weight"), "f32")
+        add("ln_pre_b", weights.load("visual.ln_pre.bias"), "f32")
+        for i in range(layers):
+            p, q = f"visual.transformer.resblocks.{i}", f"/visual/transformer/resblocks.{i}"
+            add(f"blk.{i}.ln1_w", weights.load(f"{p}.ln_1.weight"), "f32")
+            add(f"blk.{i}.ln1_b", weights.load(f"{p}.ln_1.bias"), "f32")
+            add(f"blk.{i}.qkv_w", weights.matmul_weight(f"{q}/attn/MatMul"), "mat")
+            add(f"blk.{i}.qkv_b", weights.load(f"{p}.attn.in_proj_bias"), "f32")
+            add(f"blk.{i}.out_w", weights.load(f"{p}.attn.out_proj.weight"), "mat")
+            add(f"blk.{i}.out_b", weights.load(f"{p}.attn.out_proj.bias"), "f32")
+            add(f"blk.{i}.ln2_w", weights.load(f"{p}.ln_2.weight"), "f32")
+            add(f"blk.{i}.ln2_b", weights.load(f"{p}.ln_2.bias"), "f32")
+            add(f"blk.{i}.fc1_w", weights.matmul_weight(f"{q}/mlp/c_fc/MatMul"), "mat")
+            add(f"blk.{i}.fc1_b", weights.load(f"{p}.mlp.c_fc.bias"), "f32")
+            add(f"blk.{i}.fc2_w", weights.matmul_weight(f"{q}/mlp/c_proj/MatMul"), "mat")
+            add(f"blk.{i}.fc2_b", weights.load(f"{p}.mlp.c_proj.bias"), "f32")
+        add("ln_post_w", weights.load("visual.ln_post.weight"), "f32")
+        add("ln_post_b", weights.load("visual.ln_post.bias"), "f32")
+        add("proj_w", weights.load("visual.proj").T, "mat")
+
+        writer.write_header_to_file()
+        writer.write_kv_data_to_file()
+        writer.write_tensors_to_file()
+    except UnsupportedModelError:
+        writer.close()
+        tmp_output.unlink(missing_ok=True)
+        raise
+    except BaseException:
+        writer.close()
+        tmp_output.unlink(missing_ok=True)
+        raise
+    writer.close()
+    tmp_output.replace(output)
