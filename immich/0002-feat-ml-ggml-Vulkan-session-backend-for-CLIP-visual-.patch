@@ -0,0 +1,115 @@
+from __future__ import annotations
+
+import os
+from ctypes import CDLL, POINTER, Structure, byref, c_char_p, c_float, c_int, c_size_t, c_void_p
+from pathlib import Path
+
+import numpy as np
+from numpy.typing import NDArray
+
+from immich_ml.config import log, settings
+from immich_ml.schemas import ModelPrecision
+
+
+class ClipVitParams(Structure):
+    _fields_ = [("device", c_int), ("n_threads", c_int), ("flash_attn", c_int), ("fp32_math", c_int)]
+
+
+try:
+    if not settings.ggml:
+        raise OSError("disabled by MACHINE_LEARNING_GGML=false")
+    if settings.ggml_precision == ModelPrecision.FP32:
+        # must be set before the Vulkan backend initialises (i.e. before the library is loaded)
+        os.environ.setdefault("GGML_VK_DISABLE_F16", "1")
+    libclipvit = CDLL("libclipvit.so")
+    libclipvit.clipvit_params_default.argtypes = (POINTER(ClipVitParams),)
+    libclipvit.clipvit_device_count.restype = c_int
+    libclipvit.clipvit_device_description.argtypes = (c_int,)
+    libclipvit.clipvit_device_description.restype = c_char_p
+    libclipvit.clipvit_load.argtypes = c_char_p, POINTER(ClipVitParams)
+    libclipvit.clipvit_load.restype = c_void_p
+    libclipvit.clipvit_free.argtypes = (c_void_p,)
+    libclipvit.clipvit_encode.argtypes = c_void_p, POINTER(c_float), c_int, POINTER(c_float)
+    libclipvit.clipvit_encode.restype = c_int
+    libclipvit.clipvit_embed_dim.argtypes = (c_void_p,)
+    libclipvit.clipvit_embed_dim.restype = c_int
+    libclipvit.clipvit_image_size.argtypes = (c_void_p,)
+    libclipvit.clipvit_image_size.restype = c_int
+    libclipvit.clipvit_device_name.argtypes = (c_void_p,)
+    libclipvit.clipvit_device_name.restype = c_char_p
+    libclipvit.clipvit_weights_bytes.argtypes = (c_void_p,)
+    libclipvit.clipvit_weights_bytes.restype = c_size_t
+    libclipvit.clipvit_unsupported_ops.argtypes = (c_void_p,)
+    libclipvit.clipvit_unsupported_ops.restype = c_int
+    libclipvit.clipvit_last_error.restype = c_char_p
+    device_count: int = libclipvit.clipvit_device_count()
+    is_available = device_count > 0
+    if is_available:
+        devices = [libclipvit.clipvit_device_description(i).decode() for i in range(device_count)]
+        log.info("Found ggml GPU devices: %s", devices)
+    else:
+        log.debug("libclipvit is available but no GPU device was found, using ONNX")
+except OSError as e:
+    log.debug("Could not load libclipvit, using ONNX: %s", e)
+    is_available = False
+
+
+def last_error() -> str:
+    error: bytes = libclipvit.clipvit_last_error()
+    return error.decode(errors="replace")
+
+
+class ClipVit:
+    """A CLIP vision transformer loaded from a GGUF file onto a ggml backend."""
+
+    def __init__(
+        self,
+        model_path: Path | str,
+        device: int = 0,
+        n_threads: int = 4,
+        flash_attn: bool = True,
+        fp32_math: bool = False,
+    ) -> None:
+        if not is_available:
+            raise RuntimeError("libclipvit is not available!")
+        params = ClipVitParams()
+        libclipvit.clipvit_params_default(byref(params))
+        params.device = device
+        params.n_threads = n_threads
+        params.flash_attn = int(flash_attn)
+        params.fp32_math = int(fp32_math)
+        self.model: int | None = libclipvit.clipvit_load(str(model_path).encode(), byref(params))
+        if self.model is None:
+            raise ValueError(f"Cannot load model {model_path}: {last_error()}")
+        self.embed_dim: int = libclipvit.clipvit_embed_dim(self.model)
+        self.image_size: int = libclipvit.clipvit_image_size(self.model)
+        self.device_name: str = libclipvit.clipvit_device_name(self.model).decode()
+        self.weights_bytes: int = libclipvit.clipvit_weights_bytes(self.model)
+        self.unsupported_ops: int = libclipvit.clipvit_unsupported_ops(self.model)
+
+    def __del__(self) -> None:
+        self.free()
+
+    def free(self) -> None:
+        if getattr(self, "model", None) is not None:
+            libclipvit.clipvit_free(self.model)
+            self.model = None
+
+    def encode(self, images: NDArray[np.float32]) -> NDArray[np.float32]:
+        if self.model is None:
+            raise RuntimeError("model has been freed")
+        expected = (3, self.image_size, self.image_size)
+        if images.ndim != 4 or images.shape[1:] != expected:
+            raise ValueError(f"expected images of shape (N, {', '.join(map(str, expected))}), got {images.shape}")
+        if images.dtype != np.float32 or not images.flags.c_contiguous:
+            raise ValueError("images must be a C-contiguous float32 array")
+        out: NDArray[np.float32] = np.empty((images.shape[0], self.embed_dim), dtype=np.float32)
+        status: int = libclipvit.clipvit_encode(
+            self.model,
+            images.ctypes.data_as(POINTER(c_float)),
+            images.shape[0],
+            out.ctypes.data_as(POINTER(c_float)),
+        )
+        if status != 0:
+            raise RuntimeError(f"ggml inference failed: {last_error()}")
+        return out
