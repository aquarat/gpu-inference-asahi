new file mode 100644
index 0000000..17d91c6
--- /dev/null
+++ b/machine-learning/immich_ml/sessions/mnn/__init__.py
@@ -0,0 +1,108 @@
+from __future__ import annotations
+
+from importlib.util import find_spec
+from pathlib import Path
+from threading import Lock
+from typing import Any, NamedTuple
+
+import numpy as np
+from numpy.typing import NDArray
+
+from immich_ml.config import log, settings
+from immich_ml.schemas import ModelIdentity, ModelPrecision, ModelTask, ModelType, SessionNode
+
+from .convert import ConversionError, Signature, TensorInfo, convert_model, is_converted, read_signature
+
+is_available = settings.mnn and find_spec("MNN") is not None
+
+# ONNX dtypes of the model inputs MnnSession can feed (MNN has no int64 tensors; ONNX int64 inputs take int32)
+INPUT_DTYPES: dict[str, type[np.generic]] = {"FLOAT": np.float32, "INT32": np.int32, "INT64": np.int32}
+
+
+def supports(identity: ModelIdentity) -> bool:
+    """Whether MnnSession is used for a model of this identity when the backend is available."""
+    if identity[1] == ModelTask.FACIAL_RECOGNITION:
+        return identity[0] in (ModelType.DETECTION, ModelType.RECOGNITION)
+    return identity == (ModelType.TEXTUAL, ModelTask.SEARCH) and settings.mnn_textual
+
+
+class MnnSession:
+    """
+    Runs a model converted from ONNX on MNN's CPU backend, as a drop-in replacement for an ONNX session.
+
+    Weights and arithmetic follow MACHINE_LEARNING_MNN_PRECISION (fp32 by default: MNN 3.6 returned wrong results
+    for some inputs of the ArcFace and CLIP text models with fp16 arithmetic).
+    """
+
+    def __init__(self, model_path: Path, precision: ModelPrecision | None = None) -> None:
+        import MNN.expr as expr
+        import MNN.nn as nn
+
+        self.model_path = model_path
+        signature = read_signature(model_path)
+        if signature is None:
+            raise FileNotFoundError(f"Model file not found: {model_path}")
+        self.signature: Signature = signature
+        self.precision = precision if precision is not None else settings.mnn_precision
+        self.fp16 = self.precision == ModelPrecision.FP16
+        self.lock = Lock()
+        self.expr = expr
+
+        input_names = [node["name"] for node in signature["inputs"]]
+        output_names = [node["name"] for node in signature["outputs"]]
+        log.info("Loading MNN model %s ...", model_path)
+        # every model is fed one fixed shape (the letterboxed detector input, one aligned face, padded tokens), so
+        # MNN can plan its memory once; with mutable shapes it keeps about three times the activation memory
+        self.module = nn.load_module_from_file(
+            model_path.as_posix(),
+            input_names,
+            output_names,
+            precision_mode=expr.PrecisionMode.Low if self.fp16 else expr.PrecisionMode.High,
+            thread_num=settings.mnn_threads,
+            shape_mutable=False,
+        )
+        log.info("Loaded MNN model %s (%s, %d threads)", model_path.name, self.precision.value, settings.mnn_threads)
+
+    def get_inputs(self) -> list[SessionNode]:
+        return [MnnNode(node["name"], tuple(node["shape"])) for node in self.signature["inputs"]]
+
+    def get_outputs(self) -> list[SessionNode]:
+        return [MnnNode(node["name"], tuple(node["shape"])) for node in self.signature["outputs"]]
+
+    def get_metadata(self) -> dict[str, str]:
+        return {}
+
+    def run(
+        self,
+        output_names: list[str] | None,
+        input_feed: dict[str, NDArray[np.float32]] | dict[str, NDArray[np.int32]] | dict[str, NDArray[np.uint8]],
+        run_options: Any = None,
+    ) -> list[NDArray[np.float32]]:
+        inputs = [self._to_var(node, input_feed) for node in self.signature["inputs"]]
+        with self.lock:
+            outputs = self.module.forward(inputs)
+            # the variables are owned by the module and are reused by the next call
+            results = [np.array(output.read(), copy=True) for output in outputs]
+        if output_names is None:
+            return results
+        by_name = {node["name"]: result for node, result in zip(self.signature["outputs"], results)}
+        return [by_name[name] for name in output_names]
+
+    def _to_var(self, node: TensorInfo, input_feed: dict[str, Any]) -> Any:
+        if node["name"] not in input_feed:
+            raise ValueError(f"missing model input '{node['name']}', got {list(input_feed)}")
+        dtype = INPUT_DTYPES.get(node["dtype"])
+        if dtype is None:
+            raise ValueError(f"unsupported input type {node['dtype']} for '{node['name']}'")
+        data = np.ascontiguousarray(input_feed[node["name"]], dtype=dtype)
+        mnn_dtype = self.expr.float if dtype is np.float32 else self.expr.int
+        return self.expr.const(data, list(data.shape), self.expr.NCHW, mnn_dtype)
+
+
+class MnnNode(NamedTuple):
+    name: str
+    # symbolic dimensions are strings, like the nodes of an ONNX Runtime session
+    shape: tuple[Any, ...]
+
+
+__all__ = ["ConversionError", "MnnSession", "MnnNode", "convert_model", "is_available", "is_converted", "supports"]
diff --git a/machine-learning/immich_ml/sessions/mnn/convert.py b/machine-learning/immich_ml/sessions/mnn/convert.py
new file mode 100644
index 0000000..1be2d37
--- /dev/null
+++ b/machine-learning/immich_ml/sessions/mnn/convert.py
@@ -0,0 +1,120 @@
+"""Converts an ONNX model into MNN's format for MnnSession.
+
+The conversion runs MNN's own converter in a subprocess (it holds several copies of the graph while
+optimising and the memory would otherwise stay with the worker) and records the ONNX input/output
+signature next to the converted file: MNN keeps tensor names but neither the output order nor the
+symbolic dimensions, and the models expect ONNX Runtime's.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any, TypedDict
+
+import onnx
+
+SIGNATURE_SUFFIX = ".json"
+
+
+class ConversionError(RuntimeError):
+    pass
+
+
+class TensorInfo(TypedDict):
+    name: str
+    shape: list[int | str]
+    dtype: str
+
+
+class Signature(TypedDict):
+    fp16: bool
+    inputs: list[TensorInfo]
+    outputs: list[TensorInfo]
+
+
+def signature_path(model_path: Path) -> Path:
+    return model_path.with_name(model_path.name + SIGNATURE_SUFFIX)
+
+
+def read_signature(model_path: Path) -> Signature | None:
+    try:
+        signature: Signature = json.loads(signature_path(model_path).read_text())
+        return signature
+    except (OSError, ValueError):
+        return None
+
+
+def is_converted(model_path: Path, fp16: bool) -> bool:
+    """Whether a conversion with the given weight storage exists for model_path."""
+    signature = read_signature(model_path)
+    return model_path.is_file() and signature is not None and signature["fp16"] == fp16
+
+
+def convert_model(onnx_path: Path, model_path: Path, fp16: bool) -> None:
+    """Converts onnx_path into model_path (plus its signature file) in a subprocess, with fp16 or fp32 weights."""
+    # a plain import of this module rather than -m, which would execute it twice (once as part of the package)
+    entrypoint = f"from {__name__} import main; main()"
+    args = [sys.executable, "-c", entrypoint, onnx_path.as_posix(), model_path.as_posix()]
+    if fp16:
+        args.append("--fp16")
+    try:
+        subprocess.run(args, check=True, stdin=subprocess.DEVNULL)
+    except (OSError, subprocess.CalledProcessError) as e:
+        raise ConversionError(f"MNN conversion of {onnx_path} failed: {e}") from e
+    if not is_converted(model_path, fp16):
+        raise ConversionError(f"MNN conversion of {onnx_path} did not produce {model_path}")
+
+
+def _tensor_info(value: onnx.ValueInfoProto) -> TensorInfo:
+    tensor_type = value.type.tensor_type
+    shape: list[int | str] = [dim.dim_param if dim.dim_param else dim.dim_value for dim in tensor_type.shape.dim]
+    return {"name": value.name, "shape": shape, "dtype": onnx.TensorProto.DataType.Name(tensor_type.elem_type)}
+
+
+def _onnx_signature(onnx_path: Path, fp16: bool) -> Signature:
+    model = onnx.load(onnx_path, load_external_data=False)
+    initializers = {initializer.name for initializer in model.graph.initializer}
+    return {
+        "fp16": fp16,
+        "inputs": [_tensor_info(value) for value in model.graph.input if value.name not in initializers],
+        "outputs": [_tensor_info(value) for value in model.graph.output],
+    }
+
+
+def _convert(onnx_path: Path, model_path: Path, fp16: bool) -> None:
+    import _tools  # MNN's converter, part of the mnn package
+
+    signature = _onnx_signature(onnx_path, fp16)
+    model_path.parent.mkdir(parents=True, exist_ok=True)
+    tmp_path = model_path.with_name(model_path.name + ".tmp")
+    args = ["mnnconvert", "-f", "ONNX", "--modelFile", onnx_path.as_posix(), "--MNNModel", tmp_path.as_posix()]
+    args += ["--bizCode", "immich"]
+    if fp16:
+        args.append("--fp16")
+    ok: Any = _tools.mnnconvert(args)
+    if not ok or not tmp_path.is_file():
+        tmp_path.unlink(missing_ok=True)
+        raise ConversionError(f"MNN converter failed on {onnx_path}")
+    # graphs over 2 GB are split into a weight file that MNN looks up next to the model
+    tmp_weights = tmp_path.with_name(tmp_path.name + ".weight")
+    if tmp_weights.is_file():
+        tmp_weights.replace(model_path.with_name(model_path.name + ".weight"))
+    signature_path(model_path).write_text(json.dumps(signature))
+    tmp_path.replace(model_path)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Convert an ONNX model for MnnSession")
+    parser.add_argument("onnx_path", type=Path)
+    parser.add_argument("model_path", type=Path)
+    parser.add_argument("--fp16", action="store_true", help="store weights as fp16")
+    args = parser.parse_args()
+    _convert(args.onnx_path, args.model_path, args.fp16)
+
+
+if __name__ == "__main__":
+    main()
