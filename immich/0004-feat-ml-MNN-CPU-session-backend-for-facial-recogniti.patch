+        MnnSession(model_path)
+
+        mnn.nn.load_module_from_file.assert_called_once_with(
+            model_path.as_posix(),
+            ["input.1"],
+            ["embedding", "aux"],
+            precision_mode=mnn.expr.PrecisionMode.High,
+            thread_num=2,
+            shape_mutable=False,
+        )
+        info.assert_any_call("Loading MNN model %s ...", model_path)
+
+    def test_uses_fp16_precision(self, mnn: mock.Mock, model_path: Path, mocker: MockerFixture) -> None:
+        mocker.patch.object(settings, "mnn_precision", ModelPrecision.FP16)
+
+        MnnSession(model_path)
+
+        assert mnn.nn.load_module_from_file.call_args.kwargs["precision_mode"] == mnn.expr.PrecisionMode.Low
+
+    def test_precision_argument_overrides_setting(
+        self, mnn: mock.Mock, model_path: Path, mocker: MockerFixture
+    ) -> None:
+        mocker.patch.object(settings, "mnn_precision", ModelPrecision.FP32)
+
+        MnnSession(model_path, precision=ModelPrecision.FP16)
+
+        assert mnn.nn.load_module_from_file.call_args.kwargs["precision_mode"] == mnn.expr.PrecisionMode.Low
+
+    def test_requires_signature(self, mnn: mock.Mock, tmp_path: Path) -> None:
+        with pytest.raises(FileNotFoundError):
+            MnnSession(tmp_path / "model.mnn")
+
+    def test_get_inputs_and_outputs(self, mnn: mock.Mock, model_path: Path) -> None:
+        session = MnnSession(model_path)
+
+        [input] = session.get_inputs()
+        [output, aux] = session.get_outputs()
+
+        assert input.name == "input.1"
+        assert input.shape == ("batch", 3, 112, 112)
+        assert output.name == "embedding"
+        assert output.shape == ("batch", 512)
+        assert aux.name == "aux"
+
+    def test_run(self, mnn: mock.Mock, model_path: Path) -> None:
+        embedding, aux = np.random.rand(2, 512).astype(np.float32), np.zeros(1, dtype=np.float32)
+        module = mnn.nn.load_module_from_file.return_value
+        module.forward.return_value = [mock.Mock(read=lambda: embedding), mock.Mock(read=lambda: aux)]
+        session = MnnSession(model_path)
+        crops = np.random.rand(2, 3, 112, 112).astype(np.float32)
+
+        outputs = session.run(None, {"input.1": crops})
+
+        mnn.expr.const.assert_called_once()
+        np.testing.assert_array_equal(mnn.expr.const.call_args.args[0], crops)
+        assert mnn.expr.const.call_args.args[1] == [2, 3, 112, 112]
+        module.forward.assert_called_once_with([mnn.expr.const.return_value])
+        assert len(outputs) == 2
+        np.testing.assert_array_equal(outputs[0], embedding)
+        assert outputs[0] is not embedding
+
+    def test_run_selects_outputs_by_name(self, mnn: mock.Mock, model_path: Path) -> None:
+        embedding, aux = np.random.rand(1, 512).astype(np.float32), np.zeros(1, dtype=np.float32)
+        module = mnn.nn.load_module_from_file.return_value
+        module.forward.return_value = [mock.Mock(read=lambda: embedding), mock.Mock(read=lambda: aux)]
+        session = MnnSession(model_path)
+
+        [output] = session.run(["aux"], {"input.1": np.random.rand(1, 3, 112, 112).astype(np.float32)})
+
+        np.testing.assert_array_equal(output, aux)
+
+    def test_run_rejects_missing_input(self, mnn: mock.Mock, model_path: Path) -> None:
+        session = MnnSession(model_path)
+
+        with pytest.raises(ValueError):
+            session.run(None, {"other": np.random.rand(1, 3, 112, 112).astype(np.float32)})
+
+    def test_is_converted_checks_weight_storage(self, model_path: Path) -> None:
+        assert is_converted(model_path, fp16=True)
+        assert not is_converted(model_path, fp16=False)
+        assert not is_converted(model_path.with_name("missing.mnn"), fp16=True)
+
