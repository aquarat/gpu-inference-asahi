+int NetOptimize::fuse_split_sigmoid_mul_swish()
+{
+    // x -> Split -> {a, b}; Sigmoid(b) -> s; BinaryOp MUL(a, s) -> y   ==>   Swish(x) -> y
+    // onnx2ncnn only recognises x*sigmoid(x) when the conv output is not shared, so YOLO-style
+    // graphs keep ~1/4 of their SiLU activations as Split+Sigmoid+Mul (3 dispatches + 2 barriers).
+    const size_t layer_count = layers.size();
+    const size_t blob_count = blobs.size();
+
+    // count consumers of each blob
+    std::vector<int> consumers(blob_count, 0);
+    for (size_t i = 0; i < layer_count; i++)
+    {
+        for (size_t k = 0; k < layers[i]->bottoms.size(); k++)
+        {
+            consumers[layers[i]->bottoms[k]]++;
+        }
+    }
+
+    for (size_t i = 0; i < layer_count; i++)
+    {
+        if (layers[i]->type != "BinaryOp")
+            continue;
+
+        if (layers[i]->bottoms.size() != 2)
+            continue;
+
+        ncnn::BinaryOp* binaryop = (ncnn::BinaryOp*)layers[i];
+
+        if (binaryop->op_type != ncnn::BinaryOp::Operation_MUL)
+            continue;
+
+        if (binaryop->with_scalar)
+            continue;
+
+        int b0 = binaryop->bottoms[0];
+        int b1 = binaryop->bottoms[1];
+
+        // one input comes from Sigmoid
+        int sigmoid_index = -1;
+        int a = -1;
+        for (int t = 0; t < 2; t++)
+        {
+            int sb = t == 0 ? b1 : b0;
+            int p = blobs[sb].producer;
+            if (p < 0 || p >= (int)layer_count)
+                continue;
+            if (layers[p]->type != "Sigmoid")
+                continue;
+            if (layers[p]->bottoms.size() != 1 || layers[p]->tops.size() != 1)
+                continue;
+            if (consumers[sb] != 1)
+                continue;
+            sigmoid_index = p;
+            a = t == 0 ? b0 : b1;
+            break;
+        }
+        if (sigmoid_index == -1)
+            continue;
+
+        ncnn::Layer* sigmoid = layers[sigmoid_index];
+        int b = sigmoid->bottoms[0];
+
+        // a and b must be the two outputs of the same Split
+        int split_index = blobs[a].producer;
+        if (split_index < 0 || split_index >= (int)layer_count)
+            continue;
+        if (layers[split_index]->type != "Split")
+            continue;
+        if (blobs[b].producer != split_index)
+            continue;
+        if (layers[split_index]->tops.size() != 2)
+            continue;
+        if (consumers[a] != 1 || consumers[b] != 1)
+            continue;
+
+        ncnn::Layer* split = layers[split_index];
+        int x = split->bottoms[0];
+
+        fprintf(stderr, "fuse_split_sigmoid_mul_swish %s %s %s\n", split->name.c_str(), sigmoid->name.c_str(), binaryop->name.c_str());
+
+        ncnn::Layer* swish = ncnn::create_layer_cpu("Swish");
+
+        swish->type = "Swish";
+        swish->name = binaryop->name;
+        swish->bottoms.resize(1);
+        swish->bottoms[0] = x;
+        swish->tops = binaryop->tops;
+
+        ncnn::ParamDict pd;
+        swish->load_param(pd);
+
+        blobs[x].consumer = (int)i;
+        blobs[swish->tops[0]].producer = (int)i;
+
+        split->type = "ncnnfused";
+        sigmoid->type = "ncnnfused";
+
+        layers[i] = swish;
+        delete binaryop;
+    }
+
+    return 0;
+}
