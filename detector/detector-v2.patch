--- old/detector/gen_frigate_detectors_config.py	1970-01-01 01:00:00.000000000 +0100
+++ new/detector/gen_frigate_detectors_config.py	2026-09-06 14:25:24.723056451 +0100
@@ -0,0 +1,21 @@
+"""Write a copy of Frigate's config.yaml with N `zmq` detectors (host_zmq, host_zmq_b, host_zmq_c ...) on the same endpoint.
+usage: gen_config.py <in> <out> <N>"""
+import sys, re
+src, dst, n = sys.argv[1], sys.argv[2], int(sys.argv[3])
+text = open(src).read()
+m = re.search(r"(?m)^detectors:\n(?P<body>(?:[ \t]+.*\n|[ \t]*#.*\n)+)", text)
+assert m, "detectors: block not found"
+body = m.group("body")
+# keep the existing host_zmq entry (comments included), append the extra ones after it
+suffixes = "bcdefgh"
+extra = "".join(
+    f"  # 2026-09-06: extra detector process on the SAME host service. Frigate feeds all its\n"
+    f"  # detector processes from one shared queue, so with N of them N requests are in flight\n"
+    f"  # at once and the host service (ROUTER socket) overlaps them; see detector/README-linux.md.\n"
+    f"  host_zmq_{suffixes[i]}:\n    type: zmq\n    endpoint: tcp://host.docker.internal:5555\n"
+    for i in range(n - 1)
+)
+new_body = body.rstrip("\n") + "\n" + extra
+out = text[: m.start("body")] + new_body + text[m.end("body") :]
+open(dst, "w").write(out)
+print(f"wrote {dst} with {n} detectors")
