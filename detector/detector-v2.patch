--- old/detector/loadgen.py	1970-01-01 01:00:00.000000000 +0100
+++ new/detector/loadgen.py	2026-09-06 14:25:24.722531577 +0100
@@ -0,0 +1,179 @@
+#!/usr/bin/env python3
+"""
+Multi-client load generator for the ZMQ detector: N independent REQ clients
+(one thread + socket each, exactly like N Frigate detector processes), each
+pacing requests at --rate per second with real frames, reporting per-request
+round-trip latency. Speaks the same protocol as test_client.py / Frigate.
+
+  venv/bin/python loadgen.py --endpoint tcp://127.0.0.1:5556 --clients 4 --rate 5 --duration 60 --frames DIR
+
+--check REF.npz compares every reply with a per-frame reference (saved with
+--save-ref REF.npz from a known-good run) and counts mismatching rows.
+"""
+import argparse, glob, json, os, sys, threading, time
+import numpy as np, zmq
+
+ZERO = np.zeros((20, 6), np.float32)
+
+
+def load_frames(d, size):
+    import cv2
+    out = []
+    for f in sorted(glob.glob(os.path.join(d, "*.jpg")) + glob.glob(os.path.join(d, "*.png")) + glob.glob(os.path.join(d, "*.webp"))):
+        img = cv2.imread(f)
+        if img is None:
+            continue
+        img = cv2.resize(img, (size, size))
+        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB).astype(np.float32) / 255.0
+        out.append((os.path.basename(f), np.ascontiguousarray(img.transpose(2, 0, 1)[None])))
+    return out
+
+
+def handshake(sock, model_name):
+    sock.send_multipart([json.dumps({"model_request": True, "model_name": model_name}).encode()])
+    orig = sock.getsockopt(zmq.RCVTIMEO); sock.setsockopt(zmq.RCVTIMEO, 30000)
+    try:
+        resp = json.loads(sock.recv_multipart()[0].decode())
+    finally:
+        sock.setsockopt(zmq.RCVTIMEO, orig)
+    if not (resp.get("model_available") and resp.get("model_loaded")):
+        raise RuntimeError(f"handshake failed: {resp}")
+
+
+def _same(ref, res, tol):
+    """Exact match with tol=0; otherwise same rows/classes, scores within tol, boxes within tol (normalised)."""
+    if tol <= 0:
+        return np.array_equal(ref, res)
+    a, b = ref[ref[:, 1] > 0], res[res[:, 1] > 0]
+    if a.shape != b.shape or not np.array_equal(a[:, 0], b[:, 0]):
+        return False
