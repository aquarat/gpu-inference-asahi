diff -ruN old/detector/detector/onnx_batch.py new/detector/detector/onnx_batch.py
--- old/detector/detector/onnx_batch.py	1970-01-01 01:00:00.000000000 +0100
+++ new/detector/detector/onnx_batch.py	2026-09-06 14:25:24.724261532 +0100
@@ -0,0 +1,203 @@
+"""
+Make a fixed-batch-N variant of a batch-1 ONNX export.
+
+Ultralytics-style exports hard-code the batch dimension: the graph input is
+[1, 3, H, W] and every Reshape constant starts with 1. This rewrites those
+constants (dim 0 -> -1, other dims from shape inference) and pins the input /
+output batch dim to `batch`, so the graph is valid for exactly that batch.
+
+Why a fixed batch per file rather than one dynamic model: MNN's Vulkan image
+backend computes wrong results after resizeTensor/resizeSession to batch>1
+(measured 2026-09-06, README-linux.md), while a model converted with the batch
+dim already fixed is correct. The batch-1 model is never touched, so the
+batch-1 path stays bit-identical to the single-model service.
+
+The YOLO "DFL" head (Reshape -> Transpose -> Softmax(last axis) -> Transpose ->
+1x1 Conv with weights 0..15) is rewritten to Softmax(bin axis) -> Mul(0..15) ->
+ReduceSum: MNN flattens a last-axis softmax to [N*anchors*4, 16] rows and its
+Vulkan image backend cannot address more than 16384 rows (2 images already
+need 16800), whereas the middle-axis form stays small. Same maths, ~4 fewer
+dispatches. Axis-wise Softmax needs opset >= 13, so the variant is stamped
+opset 13 when the graph contains no op whose opset-13 signature differs
+(Squeeze/Unsqueeze/Split/ReduceSum with attribute axes); otherwise the DFL is
+left alone and the batch variant is only usable where MNN handles it.
+"""
+
+import logging
+import os
+
+import numpy as np
+
+logger = logging.getLogger(__name__)
+
+
+def batch_variant_path(onnx_path: str, batch: int) -> str:
+    stem, _ = os.path.splitext(onnx_path)
+    return f"{stem}.b{batch}.onnx"
+
+
+_OPSET13_CHANGED = {"Squeeze", "Unsqueeze", "Split", "ReduceSum", "Hardmax", "LogSoftmax", "Softmax"}
+
+
+def _attr(node, name, default=None):
+    from onnx import helper
+
+    for a in node.attribute:
+        if a.name == name:
+            return helper.get_attribute_value(a)
+    return default
+
+
+def rewrite_dfl(m) -> int:
+    """Replace Reshape->Transpose->Softmax->Transpose->Conv(1x1, [1,K,1,1], no bias)
+    with Softmax(axis)->Mul->ReduceSum on the un-transposed tensor. Returns the number
+    of rewrites. Requires opset 13 semantics for Softmax/ReduceSum (caller bumps it)."""
+    from onnx import helper, numpy_helper
+
+    g = m.graph
+    inits = {i.name: i for i in g.initializer}
+    by_out = {o: n for n in g.node for o in n.output}
+    consumers = {}
+    for n in g.node:
+        for i in n.input:
+            consumers.setdefault(i, []).append(n)
+    rewrites = []
+    for sm in [n for n in g.node if n.op_type == "Softmax"]:
+        t1 = by_out.get(sm.input[0])
+        if t1 is None or t1.op_type != "Transpose":
+            continue
+        rs = by_out.get(t1.input[0])
+        if rs is None or rs.op_type != "Reshape":
+            continue
+        nxt = consumers.get(sm.output[0], [])
+        if len(nxt) != 1 or nxt[0].op_type != "Transpose":
+            continue
+        t2 = nxt[0]
+        cvs = consumers.get(t2.output[0], [])
+        if len(cvs) != 1 or cvs[0].op_type != "Conv" or len(cvs[0].input) != 2 or cvs[0].input[1] not in inits:
+            continue
+        cv = cvs[0]
+        w = numpy_helper.to_array(inits[cv.input[1]])
+        if w.ndim != 4 or w.shape[0] != 1 or w.shape[2:] != (1, 1):
+            continue
+        perm1, perm2 = list(_attr(t1, "perm", [])), list(_attr(t2, "perm", []))
+        if len(perm1) != 4 or len(perm2) != 4:
+            continue
+        axis = _attr(sm, "axis", -1)
+        axis = axis + 4 if axis < 0 else axis
+        if axis != 3:
+            continue  # opset<13 Softmax is only axis-wise on the last axis
+        orig_axis = perm1[axis]  # the bin axis in the Reshape output
+        if perm1[perm2[1]] != orig_axis or w.shape[1] != 16 and False:
+            continue
+        remaining = [d for d in range(1, 4) if d != orig_axis]
+        if [perm1[perm2[2]], perm1[perm2[3]]] != remaining:
+            continue
+        rewrites.append((rs, t1, sm, t2, cv, w, orig_axis))
+
+    for rs, t1, sm, t2, cv, w, orig_axis in rewrites:
+        k = w.shape[1]
+        wshape = [1, 1, 1, 1]
+        wshape[orig_axis] = k
+        wname = f"{cv.name or cv.output[0]}_dfl_bins"
+        g.initializer.append(numpy_helper.from_array(w.reshape(wshape).astype(w.dtype), wname))
+        axes_name = f"{cv.name or cv.output[0]}_dfl_axes"
+        g.initializer.append(numpy_helper.from_array(np.array([orig_axis], np.int64), axes_name))
+        base = sm.name or sm.output[0]
+        new_nodes = [
+            helper.make_node("Softmax", [rs.output[0]], [base + "_dfl_sm"], name=base + "_dfl_softmax", axis=orig_axis),
+            helper.make_node("Mul", [base + "_dfl_sm", wname], [base + "_dfl_mul"], name=base + "_dfl_mul"),
+            helper.make_node("ReduceSum", [base + "_dfl_mul", axes_name], [cv.output[0]], name=base + "_dfl_sum", keepdims=0),
+        ]
+        idx = list(g.node).index(cv)
+        for n in (t1, sm, t2, cv):
+            g.node.remove(n)
+        idx = min(idx, len(g.node))
+        for j, n in enumerate(new_nodes):
+            g.node.insert(idx - 3 + j if idx >= 3 else j, n)
+    return len(rewrites)
+
+
+def make_batch_variant(onnx_path: str, batch: int, out_path: str) -> str:
+    """Write the batch-`batch` variant of onnx_path to out_path (atomically). Raises on failure."""
+    import onnx
+    from onnx import numpy_helper, shape_inference
+
+    m = onnx.load(onnx_path)
+    try:
+        inferred = shape_inference.infer_shapes(m)
+        vi = {
+            v.name: [d.dim_value for d in v.type.tensor_type.shape.dim]
+            for v in list(inferred.graph.value_info) + list(inferred.graph.output)
+        }
+    except Exception as e:  # noqa: BLE001
+        logger.warning(f"[onnx_batch] shape inference failed ({e}); using 0 = copy-from-input for batch dims")
+        vi = {}
+
+    inits = {i.name: i for i in m.graph.initializer}
+    consts = {n.output[0]: n for n in m.graph.node if n.op_type == "Constant"}
+    patched = 0
+    for n in m.graph.node:
+        if n.op_type != "Reshape" or len(n.input) < 2:
+            continue
+        s = n.input[1]
+        if s in inits:
+            v = numpy_helper.to_array(inits[s]).copy()
+        elif s in consts:
+            v = numpy_helper.to_array(consts[s].attribute[0].t).copy()
+        else:
+            continue  # data-dependent shape: leave it
+        if v.ndim != 1 or len(v) < 2 or v[0] != 1:
+            continue
+        out_shape = vi.get(n.output[0])
+        if out_shape and len(out_shape) == len(v) and all(d > 0 for d in out_shape[1:]):
+            new = np.array(out_shape, dtype=np.int64)
+            new[0] = -1
+        else:
+            new = v.astype(np.int64)
+            new[0] = 0  # ONNX Reshape: 0 = copy that dim from the input
+        # give every Reshape its own constant (the export shares them)
+        name = f"{n.name or n.output[0]}_batch{batch}_shape"
+        m.graph.initializer.append(numpy_helper.from_array(new, name))
+        n.input[1] = name
+        patched += 1
+
+    for t in list(m.graph.input) + list(m.graph.output):
+        dims = t.type.tensor_type.shape.dim
+        if len(dims) and (dims[0].dim_value == 1 or dims[0].dim_param):
+            dims[0].dim_value = batch
+    # stale intermediate shapes would confuse checkers/converters
+    del m.graph.value_info[:]
+
+    opset = max((o.version for o in m.opset_import if o.domain in ("", "ai.onnx")), default=0)
+    ops = {n.op_type for n in m.graph.node}
+    dfl = 0
+    if opset >= 13 or not (ops & (_OPSET13_CHANGED - {"Softmax"})):
+        if opset < 13:
+            for o in m.opset_import:
+                if o.domain in ("", "ai.onnx"):
+                    o.version = 13
+        dfl = rewrite_dfl(m)
+    else:
+        logger.warning(f"[onnx_batch] opset {opset} graph uses {sorted(ops & _OPSET13_CHANGED)}; DFL head left as is")
+    used = {i for n in m.graph.node for i in n.input}
+    for init in [i for i in m.graph.initializer if i.name not in used]:
+        m.graph.initializer.remove(init)
+    onnx.checker.check_model(m)
+    tmp = out_path + ".tmp"
+    onnx.save(m, tmp)
+    os.replace(tmp, out_path)
+    logger.info(f"[onnx_batch] wrote batch-{batch} variant {out_path} ({patched} Reshape shapes rewritten, {dfl} DFL head(s) rewritten)")
+    return out_path
+
+
+def ensure_batch_variant(onnx_path: str, batch: int) -> str:
+    """Path to the cached batch-`batch` variant next to the model, (re)built when stale."""
+    out = batch_variant_path(onnx_path, batch)
+    try:
+        fresh = os.path.getmtime(out) >= os.path.getmtime(onnx_path) and os.path.getsize(out) > 0
+    except OSError:
+        fresh = False
+    if not fresh:
+        make_batch_variant(onnx_path, batch, out)
+    return out
